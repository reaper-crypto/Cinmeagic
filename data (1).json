



// Base URL of the CINEMAGIC backend API.
// Change this if your backend runs on a different host/port.
const API_BASE_URL = window.CINEMAGIC_API_BASE_URL || 'http://localhost:5000';

async function loadJSONData() {
    try {
        const response = await fetch(`${API_BASE_URL}/api/data/full`);
        if (!response.ok) {
            throw new Error('Failed to load data from API');
        }
        const data = await response.json();
        console.log('✅ Loaded data from MongoDB API:', data);
        return data;
    } catch (error) {
        console.error('❌ Error loading data from API:', error);
        alert('Failed to load application data. Please make sure the backend server is running and refresh the page.');
        return null;
    }
}

// Fetch the seats already booked for a specific movie/date/time from MongoDB
async function fetchBookedSeats(movieId, date, time) {
    try {
        const params = new URLSearchParams({ movieId, date, time });
        const response = await fetch(`${API_BASE_URL}/api/bookings/seats?${params.toString()}`);
        if (!response.ok) throw new Error('Failed to load seat availability');
        const data = await response.json();
        return data.bookedSeats || [];
    } catch (error) {
        console.error('❌ Error loading booked seats:', error);
        return [];
    }
}

// Submit a finished booking to MongoDB via the API
async function submitBooking(bookingPayload) {
    const response = await fetch(`${API_BASE_URL}/api/bookings`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(bookingPayload)
    });
    const data = await response.json();
    if (!response.ok) {
        throw new Error(data.error || 'Failed to save booking');
    }
    return data;
}



function updateUIFromJSON(data) {
    
    const websiteNameElement = document.getElementById('website-name');
    if (websiteNameElement && data.ui) {
        websiteNameElement.textContent = data.ui.websiteName;
    }

    
    if (data.ui && data.ui.seatColors) {
        document.documentElement.style.setProperty('--seat-available', data.ui.seatColors.available);
        document.documentElement.style.setProperty('--seat-selected', data.ui.seatColors.selected);
        document.documentElement.style.setProperty('--seat-booked', data.ui.seatColors.booked);
    }

    console.log('✅ UI updated from JSON configuration');
}




function formatCurrency(amount, data) {
    return `${data.currency.symbol}${amount.toFixed(2)}`;
}


function getMovieById(movieId, data) {
    return data.movies.find(m => m.id === movieId) || null;
}


function validateBookingData() {
    const required = ['selectedMovieId', 'selectedDate', 'selectedTime', 'selectedSeats', 'totalPrice'];
    const missing = required.filter(key => !localStorage.getItem(key));
    
    if (missing.length > 0) {
        console.error('❌ Missing booking data:', missing);
        return false;
    }
    
    return true;
}


function clearBookingData() {
    localStorage.clear();
    console.log('✅ Booking data cleared');
}


